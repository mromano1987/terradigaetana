        "custom_liquid": "{{ 'terradigaetana.css' | asset_url | stylesheet_tag }}\n<div class=\"tdg tdg-hero\">\n  <img class=\"tdg-hero__logo\" src=\"https://cdn.shopify.com/s/files/1/1099/6950/6695/files/terradigaetana-logo-full.png?width=900\" alt=\"Terra di Gaetana – Sicilia · Olio Extravergine\" width=\"900\" height=\"554\">\n  <img class=\"tdg-orn\" src=\"https://cdn.shopify.com/s/files/1/1099/6950/6695/files/terradigaetana-ornament.png?width=400\" alt=\"\" width=\"400\" height=\"65\">\n  <h1>Natives Olivenöl extra aus Mirabella Imbaccari</h1>\n  <p>Mit einer Geschichte, die bei meiner Familie beginnt – und nicht im Marketingbüro erfunden wurde.</p>\n  <div class=\"tdg-btns\">\n    <a class=\"tdg-btn tdg-btn--solid\" href=\"/collections/all\">Zum Shop</a>\n    <a class=\"tdg-btn tdg-btn--ghost\" href=\"/pages/unsere-geschichte\">Unsere Geschichte</a>\n  </div>\n</div>",
        "section_width": "page-width",
        "padding-block-start": 72,
        "padding-block-end": 88
      }
    },
    "tdg_values": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{{ 'terradigaetana.css' | asset_url | stylesheet_tag }}\n<div class=\"tdg tdg-values\">\n  <div class=\"tdg-value\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><circle cx=\"24\" cy=\"20\" r=\"7\"/><path d=\"M24 42s-14-11-14-22a14 14 0 0 1 28 0c0 11-14 22-14 22z\"/></svg><h3>Mirabella Imbaccari</h3><p>Herkunftsort im Herzen Siziliens, Provinz Catania.</p></div>\n  <div class=\"tdg-value\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path d=\"M24 42V20\"/><path d=\"M24 26c-7-1-11-6-11-13 7 1 11 6 11 13z\"/><path d=\"M24 22c6-1 10-5 10-11-6 1-10 5-10 11z\"/></svg><h3>Familiäre Verbindung</h3><p>Direkter Bezug über Anbau und Ernte meiner Familie.</p></div>\n  <div class=\"tdg-value\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path d=\"M6 24s7-12 18-12 18 12 18 12-7 12-18 12S6 24 6 24z\"/><circle cx=\"24\" cy=\"24\" r=\"5\"/></svg><h3>Volle Transparenz</h3><p>Vom Olivenbaum über die Mühle bis zur Flasche nachvollziehbar.</p></div>\n</div>",
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64,
        "background_color": "#EFE8DA"
      }
